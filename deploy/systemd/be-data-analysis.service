[Unit]
Description=be-data-analysis Python market collection service
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/data/content/be-data-analysis
Environment=APP_ENV=prod
Environment=PYTHONUNBUFFERED=1
ExecStart=/data/content/be-data-analysis/.venv/bin/python -m app serve
Restart=on-failure
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes
TimeoutStopSec=60
StandardOutput=append:/data/logs/be-data-analysis/service.log
StandardError=inherit
UMask=0027
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
