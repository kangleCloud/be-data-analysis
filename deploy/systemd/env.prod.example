# 原生部署样例：替换文字占位符，真实凭据沿用服务器私有 .env.prod，不提交。
SERVICE_HOST=填写Python虚拟IP
SERVICE_PORT=18801
SERVICE_LOG_LEVEL=info

REDIS_URL=填写原Redis虚拟IP
REDIS_PASSWORD=填写原Redis私有密码
REDIS_PORT=6379
REDIS_DB=2
SOURCE_TIMEOUT_SECONDS=15
REDIS_LOCK_SECONDS=240

STOCK_MONITOR_XQ_ENABLED=false
XUEQIU_TOKEN=
STOCK_MONITOR_INTERNAL_TOKEN=填写现有内部令牌
