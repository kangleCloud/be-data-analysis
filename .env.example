# Uvicorn 服务配置
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
SERVICE_LOG_LEVEL=info

# 行情数据源：baidu_finance 或 mock
DATA_PROVIDER=baidu_finance

# 股票名称解析器：eastmoney 或 mock
SYMBOL_RESOLVER=eastmoney

# 外部公开接口配置
BAIDU_FINANCE_BASE_URL=https://finance.pae.baidu.com
EASTMONEY_SEARCH_BASE_URL=https://searchapi.eastmoney.com
EXTERNAL_HTTP_TIMEOUT_SECONDS=10
EXTERNAL_HTTP_RETRY_COUNT=2
SYMBOL_CACHE_TTL_SECONDS=3600

# 可选百度 Cookie。只通过进程环境注入，不要提交真实值
BAIDU_AB_SR=
