# 本地复制为 .env.dev；生产复制为 .env.prod，真实凭据不提交。
# APP_ENV 由启动命令或部署配置指定，不放在此文件中。
# 与业务后端使用同一个 Redis 实例和 DB 2；容器访问宿主机填 host.docker.internal。
REDIS_URL=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=2
SOURCE_TIMEOUT_SECONDS=15
REDIS_LOCK_SECONDS=240

# 雪球 API：启用时同时配置令牌。
XUEQIU_TOKEN=
STOCK_MONITOR_XQ_ENABLED=false

# Java 调用内部接口的鉴权令牌。
STOCK_MONITOR_INTERNAL_TOKEN=

# 服务监听：容器内 8000，宿主机端口由 compose.yaml 映射；原生部署参考专用样例。
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
SERVICE_LOG_LEVEL=info
