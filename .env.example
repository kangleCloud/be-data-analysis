# 与 be-vita 使用同一个 Redis 实例和 DB 2；密码只放在本地环境变量中
REDIS_URL=redis://localhost
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=2
SOURCE_TIMEOUT_SECONDS=15
REDIS_LOCK_SECONDS=240

# 雪球 API
XUEQIU_TOKEN=
STOCK_MONITOR_XQ_ENABLED=false
STOCK_MONITOR_INTERNAL_TOKEN=

# 可选的 /health 服务
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
SERVICE_LOG_LEVEL=info
